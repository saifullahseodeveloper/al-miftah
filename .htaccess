RewriteEngine On
RewriteBase /

# LiteSpeed Cache Control
<IfModule LiteSpeed>
CacheLookup off
</IfModule>

# 1. Fix Legacy / Nested Donate URLs -> donate.php
RewriteRule ^donate/donate/?$ /donate.php [R=301,L]
RewriteRule ^donate/?$ /donate.php [R=301,L]

# Force UTF-8 encoding
AddDefaultCharset UTF-8

# Remove .php extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*?)/?$ $1.php [L]

# Redirect root to index.php if needed (usually handled by DirectoryIndex)
DirectoryIndex index.php

# Prevent listing directories
Options -Indexes
